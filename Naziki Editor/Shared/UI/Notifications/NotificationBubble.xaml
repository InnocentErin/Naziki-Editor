<UserControl x:Class="Naziki_Editor.Views.Notifications.NotificationBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="NotificationRoot">

    <UserControl.Resources>
        <!-- 颜色转换器：根据通知类型返回对应的颜色资源 -->
        <Style x:Key="TypeIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource NotificationSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource NotificationWarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource NotificationErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Info">
                    <Setter Property="Background" Value="{DynamicResource NotificationInfoBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 图标样式 -->
        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Margin" Value="0,1,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Success">
                    <Setter Property="Foreground" Value="{DynamicResource NotificationSuccessBrush}"/>
                    <Setter Property="Text" Value="✓"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Warning">
                    <Setter Property="Foreground" Value="{DynamicResource NotificationWarningBrush}"/>
                    <Setter Property="Text" Value="⚠"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Error">
                    <Setter Property="Foreground" Value="{DynamicResource NotificationErrorBrush}"/>
                    <Setter Property="Text" Value="✕"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Info">
                    <Setter Property="Foreground" Value="{DynamicResource NotificationInfoBrush}"/>
                    <Setter Property="Text" Value="ℹ"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 背景色样式 -->
        <Style x:Key="BgStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Success">
                    <Setter Property="Background" Value="{DynamicResource NotificationSuccessBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NotificationSuccessBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Warning">
                    <Setter Property="Background" Value="{DynamicResource NotificationWarningBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NotificationWarningBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Error">
                    <Setter Property="Background" Value="{DynamicResource NotificationErrorBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NotificationErrorBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Info">
                    <Setter Property="Background" Value="{DynamicResource NotificationInfoBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource NotificationInfoBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 气泡主体：动态宽高，随内容自适应 -->
    <Border Style="{DynamicResource BgStyle}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            MinWidth="280"
            MaxWidth="420"
            Margin="0,4"
            MouseEnter="Bubble_MouseEnter"
            MouseLeave="Bubble_MouseLeave"
            MouseLeftButtonDown="Bubble_MouseLeftButtonDown"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect Color="#40000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <!-- 使用 Grid 替代 StackPanel，让文本列受限于 MaxWidth 实现自动换行 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>   <!-- 左侧颜色指示条 -->
                <ColumnDefinition Width="Auto"/>   <!-- 图标 -->
                <ColumnDefinition Width="*"/>      <!-- 消息文本（自适应填充剩余宽度） -->
                <ColumnDefinition Width="Auto"/>   <!-- 右侧关闭按钮 -->
            </Grid.ColumnDefinitions>

            <!-- 左侧类型颜色指示条 -->
            <Border Grid.Column="0" Style="{DynamicResource TypeIndicatorStyle}"/>

            <!-- 图标 -->
            <TextBlock Grid.Column="1" Style="{DynamicResource IconStyle}"/>

            <!-- 消息文本：自动换行，高度随内容自适应 -->
            <TextBlock Grid.Column="2" x:Name="MessageText"
                       Text="{Binding Message, ElementName=NotificationRoot}"
                       Foreground="{DynamicResource NotificationTextBrush}"
                       FontSize="13"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       LineHeight="18"
                       MaxWidth="340"/>

            <!-- 右侧关闭按钮 -->
            <Button Grid.Column="3"
                    x:Name="CloseButton"
                    Width="24" Height="24"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Top"
                    Margin="6,0,0,0"
                    Click="CloseButton_Click"
                    Cursor="Hand"
                    ToolTip="关闭通知">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="CloseIcon"
                                       Text="✕"
                                       FontSize="12"
                                       Foreground="{DynamicResource NotificationCloseBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" TargetName="CloseIcon" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>