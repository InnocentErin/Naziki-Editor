<UserControl x:Class="Naziki_Editor.Views.Loading.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="Collapsed"
             IsHitTestVisible="False">
    <Border Background="#99000000" Padding="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ui:ProgressRing Width="42" Height="42" IsIndeterminate="{Binding IsIndeterminate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Foreground="White" FontSize="15" Margin="0,14,0,0"
                       HorizontalAlignment="Center" TextAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>
