<Application x:Class="Naziki_Editor.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 主题颜色资源 (索引 0-2)，由 ThemeManager 动态替换 -->
                <ResourceDictionary Source="Themes/Dark/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Dark/NotificationColors.xaml"/>
                <ResourceDictionary Source="Themes/Dark/TimelineColors.xaml"/>
                <!-- 基础样式 (索引 3+)，不随主题变化 -->
                <ResourceDictionary Source="Themes/Base/Styles.xaml"/>
                <ResourceDictionary Source="Themes/Base/TimelineStyles.xaml"/>
                <ResourceDictionary Source="Themes/Base/TimelineTabs.xaml"/>
                <ResourceDictionary Source="Themes/Base/NotificationStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
