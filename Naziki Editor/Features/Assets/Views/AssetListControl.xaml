<UserControl x:Class="Naziki_Editor.Views.AssetListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Naziki_Editor.Views"
             mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300">

    <UserControl.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Copy" Executed="CommandCopy_Executed" CanExecute="Command_CanExecuteWithSelection" />
        <CommandBinding Command="ApplicationCommands.Paste" Executed="CommandPaste_Executed" />
        <CommandBinding Command="ApplicationCommands.Delete" Executed="CommandDelete_Executed" CanExecute="Command_CanExecuteWithSelection" />
    </UserControl.CommandBindings>


    <UserControl.Resources>
        <!-- 🖼️ 缩略图转换器：将文件路径转为 BitmapImage，避免文件锁定 -->
        <local:FilePathToImageConverter x:Key="FilePathToImageConverter"/>

        <DataTemplate x:Key="AssetTileTemplate">
            <Border x:Name="TileBorder" Width="85" Height="100" Margin="5" Padding="5" 
                    Background="{DynamicResource SideBgColor}" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                    PreviewMouseLeftButtonDown="TileBorder_PreviewMouseLeftButtonDown"
                    PreviewMouseMove="TileBorder_PreviewMouseMove">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="➕ 添加到当前时间" Click="MenuAdd_Click"/>
                        <MenuItem Header="🛠️ 添加并编辑" Click="MenuAdd_Click"/>
                        <Separator/>
                        <MenuItem Header="✏️ 重命名素材" Click="MenuRename_Click"/>
                        <MenuItem Header="📂 在文件夹中定位" Click="MenuLocate_Click"/>
                        <Separator/>
                        <MenuItem Header="📄 复制 (Ctrl+C)" Command="ApplicationCommands.Copy"/>
                        <MenuItem Header="📋 粘贴 (Ctrl+V)" Command="ApplicationCommands.Paste"/>
                        <Separator/>
                        <MenuItem Header="🗑️ 删除 (Delete)" Command="ApplicationCommands.Delete" Foreground="IndianRed"/>
                    </ContextMenu>
                </Border.ContextMenu>


                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 🖼️ 缩略图区域：图片素材显示真实缩略图，非图片素材显示 emoji 图标 -->
                    <Viewbox Grid.Row="0" Margin="5">
                        <Grid>
                            <!-- 图片缩略图 -->
                            <Image x:Name="ThumbnailImage"
                                   Source="{Binding FilePath, Converter={StaticResource FilePathToImageConverter}}"
                                   Stretch="Uniform"
                                   Visibility="Collapsed"/>
                            <!-- 类型图标（非图片素材） -->
                            <TextBlock x:Name="TypeIcon" 
                                       FontSize="36" TextAlignment="Center"
                                       VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AssetType}" Value="Image">
                                                <Setter Property="Text" Value="🖼️"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AssetType}" Value="Video">
                                                <Setter Property="Text" Value="🎬"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AssetType}" Value="Text">
                                                <Setter Property="Text" Value="📝"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AssetType}" Value="Line">
                                                <Setter Property="Text" Value="📏"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AssetType}" Value="Template">
                                                <Setter Property="Text" Value="📦"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AssetType}" Value="Scene">
                                                <Setter Property="Text" Value="🎭"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Viewbox>

                    <Grid Grid.Row="1" Margin="0,5,0,0">
                        <TextBlock x:Name="TxtDisplay" Text="{Binding DisplayName}" 
                                   Foreground="{DynamicResource MainTextColor}" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Visibility="Visible"/>

                        <TextBox x:Name="EditBox" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"
                                 Background="{DynamicResource BoardBgColor}" Foreground="{DynamicResource MainTextColor}" 
                                 BorderThickness="1" BorderBrush="{DynamicResource HighlightBorderColor}"
                                 FontSize="11" TextAlignment="Center" 
                                 KeyDown="EditBox_KeyDown" LostFocus="EditBox_LostFocus" Loaded="EditBox_Loaded"/>
                    </Grid>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="TxtDisplay" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="EditBox" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True">
                    <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource HighlightBorderColor}"/>
                    <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource MenuBgColor}"/>
                </DataTrigger>
                <!-- 🖼️ 图片素材显示缩略图，隐藏 emoji 图标 -->
                <DataTrigger Binding="{Binding AssetType}" Value="Image">
                    <Setter TargetName="ThumbnailImage" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="TypeIcon" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ContextMenu x:Key="ListBoxGlobalMenu">
            <MenuItem Header="📋 粘贴 (Ctrl+V)" Command="ApplicationCommands.Paste"/>
            <Separator/>
            <MenuItem Header="🔄 刷新素材库 (Scan Assets)" Click="MenuRefresh_Click"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 📥 导入素材按钮栏 -->
        <Border Grid.Row="0" Padding="5,4" Background="{DynamicResource MenuBgColor}">
            <Button x:Name="BtnImportAsset" Content="📥 导入素材" 
                    Click="BtnImportAsset_Click"
                    HorizontalAlignment="Stretch" Height="28" Margin="2,0"
                    Background="{DynamicResource HighlightBorderColor}" 
                    Foreground="White" FontSize="12" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="8,4"
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Border>

        <TabControl Grid.Row="1" x:Name="AssetTabControl" Background="Transparent" BorderThickness="0" ItemContainerStyle="{DynamicResource HorizontalTabItemStyle}">
            <TabItem Header="媒体">
                <ListBox x:Name="MediaListBox" MouseDoubleClick="ListAssets_MouseDoubleClick" ItemTemplate="{StaticResource AssetTileTemplate}" SelectionMode="Extended" ContextMenu="{StaticResource ListBoxGlobalMenu}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </TabItem>
            <TabItem Header="文本">
                <ListBox x:Name="TextListBox" MouseDoubleClick="ListAssets_MouseDoubleClick" ItemTemplate="{StaticResource AssetTileTemplate}" SelectionMode="Extended" ContextMenu="{StaticResource ListBoxGlobalMenu}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </TabItem>
            <TabItem Header="线条">
                <ListBox x:Name="LineListBox" MouseDoubleClick="ListAssets_MouseDoubleClick" ItemTemplate="{StaticResource AssetTileTemplate}" SelectionMode="Extended" ContextMenu="{StaticResource ListBoxGlobalMenu}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </TabItem>
            <TabItem Header="模板">
                <ListBox x:Name="TemplateListBox" MouseDoubleClick="ListAssets_MouseDoubleClick" ItemTemplate="{StaticResource AssetTileTemplate}" SelectionMode="Extended" ContextMenu="{StaticResource ListBoxGlobalMenu}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
