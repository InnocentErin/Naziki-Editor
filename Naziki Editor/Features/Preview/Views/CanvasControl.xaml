<UserControl x:Class="Naziki_Editor.Views.CanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:Naziki_Editor.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <TabControl x:Name="CanvasTabControl"
                TabStripPlacement="Top"
                Background="{DynamicResource MainBgColor}"
                BorderThickness="0"
                ItemContainerStyle="{DynamicResource HorizontalTabItemStyle}"
                SelectionChanged="TabControl_SelectionChanged">
        <TabItem Header="原生实时预览 (Canvas)">
            <Grid Background="{DynamicResource BoardBgColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource MenuBgColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,0,0,1"
                        Padding="10,6">
                    <DockPanel>
                        <Button x:Name="BtnReloadPlayer"
                                DockPanel.Dock="Right"
                                Content="重载播放器"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                ToolTip="重新启动 Unity 预览进程并恢复当前关卡"
                                Click="BtnReloadPlayer_Click"/>
                        <Button x:Name="BtnReloadLevel"
                                DockPanel.Dock="Right"
                                Content="重载关卡"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                ToolTip="重新读取关卡资源，不重启 Unity 进程"
                                Click="BtnReloadLevel_Click"/>
                        <Button x:Name="BtnRetryPreview"
                                DockPanel.Dock="Right"
                                Content="重试"
                                Padding="10,3"
                                Margin="8,0,0,0"
                                Visibility="Collapsed"
                                Click="BtnRetryPreview_Click"/>
                        <Button x:Name="BtnPreviewDiagnostics"
                                DockPanel.Dock="Right"
                                Content="查看诊断"
                                Padding="10,3"
                                Visibility="Collapsed"
                                Click="BtnPreviewDiagnostics_Click"/>
                        <Button x:Name="BtnRepairResources"
                                DockPanel.Dock="Right"
                                Content="修复资源"
                                Padding="10,3"
                                Margin="0,0,8,0"
                                Visibility="Collapsed"
                                Click="BtnRepairResources_Click"/>
                        <TextBlock x:Name="TxtPreviewState"
                                   Text="正在准备 Unity Original Player…"
                                   Foreground="{DynamicResource TipsColor}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

                <Grid Grid.Row="1" x:Name="UnityHostContainer"
                      Background="Black"
                      SizeChanged="UnityHostContainer_SizeChanged">
                    <TextBlock x:Name="PreviewFallbackText"
                               Text="Unity Original Player 尚未就绪"
                               Foreground="#BFFFFFFF"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="2"
                        Background="{DynamicResource MenuBgColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,1,0,0"
                        Padding="8,5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnAspect169" Tag="16:9" Click="AspectRatioButton_Click"
                                Padding="10,4" Margin="3,0" ToolTip="16:9 宽屏设备">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="18" BorderThickness="2"
                                        BorderBrush="{DynamicResource MainTextColor}" CornerRadius="2"/>
                                <TextBlock Text="16:9" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAspect43" Tag="4:3" Click="AspectRatioButton_Click"
                                Padding="10,4" Margin="3,0" ToolTip="4:3 标准设备">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="24" Height="18" BorderThickness="2"
                                        BorderBrush="{DynamicResource MainTextColor}" CornerRadius="2"/>
                                <TextBlock Text="4:3" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnAspect219" Tag="21:9" Click="AspectRatioButton_Click"
                                Padding="10,4" Margin="3,0" ToolTip="21:9 超宽设备">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="42" Height="18" BorderThickness="2"
                                        BorderBrush="{DynamicResource MainTextColor}" CornerRadius="2"/>
                                <TextBlock Text="21:9" Margin="7,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="事件源代码">
            <Grid Background="{DynamicResource MainBgColor}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource MenuBgColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="0,0,0,1"
                        Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnApplyJson"
                                Content="应用修改 (Apply)"
                                Click="BtnApplyJson_Click"
                                Background="{DynamicResource HighlightBorderColor}"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="15,5"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,10,0"/>
                        <Button x:Name="BtnPreviewGlobal"
                                Content="预览全局代码"
                                Click="BtnPreviewGlobal_Click"
                                Background="{DynamicResource SideBgColor}"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="15,5"
                                BorderThickness="0"
                                Cursor="Hand"/>
                        <TextBlock x:Name="TxtJsonStatus"
                                   Text="请编辑代码，完成后点击“应用”同步到故事板。"
                                   Foreground="{DynamicResource TipsColor}"
                                   VerticalAlignment="Center"
                                   Margin="15,0,0,0"/>
                    </StackPanel>
                </Border>

                <controls:JsonCodeEditor Grid.Row="1"
                                         x:Name="JsonEditor"
                                         TextChanged="JsonEditor_TextChanged"/>

                <Grid x:Name="NoSelectionHint"
                      Grid.Row="1"
                      Background="{DynamicResource MainBgColor}"
                      Visibility="Collapsed">
                    <TextBlock Text="请选择事件以查看源代码，或点击上方“预览全局代码”。"
                               Foreground="{DynamicResource TipsColor}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               Opacity="0.7"/>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
