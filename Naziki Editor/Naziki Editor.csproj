<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Naziki_Editor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tutorial\**" />
    <Compile Remove="before\**" />
    <Compile Remove="NazikiEditor.Tests\**" />
    <Compile Remove="Tests\**" />
    <Compile Remove="External\original_player\**" />
    <Page Remove="before\**" />
    <Page Remove="External\original_player\**" />
    <None Remove="before\**" />
    <None Remove="External\original_player\**" />
    <Resource Remove="before\**" />
    <Resource Remove="External\original_player\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\NoteSkins\Cytus2_Default\CDrag.png" />
    <None Remove="Resources\NoteSkins\Cytus2_Default\CDragChild.png" />
    <None Remove="Resources\NoteSkins\Cytus2_Default\Click.png" />
    <None Remove="Resources\NoteSkins\Cytus2_Default\Drag.png" />
    <None Remove="Resources\NoteSkins\Cytus2_Default\DragChild.png" />
    <None Remove="Resources\NoteSkins\Cytus2_Default\Flick.png" />
    <None Remove="Resources\NoteSkins\Cytus2_Default\Hold.png" />
    <None Remove="Resources\NoteSkins\Cytus2_Default\LongHold.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="NAudio.Vorbis" Version="1.5.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Ookii.Dialogs.Wpf" Version="5.0.1" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Core\Serialization\storyboard-properties.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Runtime\OriginalPlayer\**\*">
      <Link>Runtime\OriginalPlayer\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Icon\" />
    <Folder Include="ProjectAbout\" />
    <Folder Include="Resources\Sounds\NoteSound\Cytus_Default\" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\CDrag.png" />
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\CDragChild.png" />
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\Click.png" />
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\Drag.png" />
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\DragChild.png" />
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\Flick.png" />
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\Hold.png" />
    <Resource Include="Resources\NoteSkins\Cytus2_Default\Notes\LongHold.png" />
  </ItemGroup>

</Project>
