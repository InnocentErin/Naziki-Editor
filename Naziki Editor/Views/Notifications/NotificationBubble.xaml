<UserControl x:Class="Naziki_Editor.Views.Notifications.NotificationBubble"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="60" d:DesignWidth="380"
             x:Name="NotificationRoot">

    <UserControl.Resources>
        <!-- 颜色转换器：根据通知类型返回对应的颜色资源 -->
        <Style x:Key="TypeIndicatorStyle" TargetType="Border">
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,2,10,2"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Success">
                    <Setter Property="Background" Value="{StaticResource NotificationSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource NotificationWarningBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource NotificationErrorBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Info">
                    <Setter Property="Background" Value="{StaticResource NotificationInfoBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 图标样式 -->
        <Style x:Key="IconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Success">
                    <Setter Property="Foreground" Value="{StaticResource NotificationSuccessBrush}"/>
                    <Setter Property="Text" Value="✓"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Warning">
                    <Setter Property="Foreground" Value="{StaticResource NotificationWarningBrush}"/>
                    <Setter Property="Text" Value="⚠"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Error">
                    <Setter Property="Foreground" Value="{StaticResource NotificationErrorBrush}"/>
                    <Setter Property="Text" Value="✕"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Info">
                    <Setter Property="Foreground" Value="{StaticResource NotificationInfoBrush}"/>
                    <Setter Property="Text" Value="ℹ"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 背景色样式 -->
        <Style x:Key="BgStyle" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Success">
                    <Setter Property="Background" Value="{StaticResource NotificationSuccessBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NotificationSuccessBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource NotificationWarningBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NotificationWarningBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Error">
                    <Setter Property="Background" Value="{StaticResource NotificationErrorBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NotificationErrorBorderBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type, ElementName=NotificationRoot}" Value="Info">
                    <Setter Property="Background" Value="{StaticResource NotificationInfoBgBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource NotificationInfoBorderBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 气泡主体 -->
    <Border Style="{StaticResource BgStyle}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12,10"
            MinWidth="280"
            MaxWidth="420"
            Margin="0,4"
            MouseEnter="Bubble_MouseEnter"
            MouseLeave="Bubble_MouseLeave"
            MouseLeftButtonDown="Bubble_MouseLeftButtonDown"
            Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect Color="#40000000" BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧类型颜色指示条 -->
            <Border Grid.Column="0" Style="{StaticResource TypeIndicatorStyle}"/>

            <!-- 中间：图标 + 消息文本 -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource IconStyle}"/>
                <TextBlock x:Name="MessageText"
                           Text="{Binding Message, ElementName=NotificationRoot}"
                           Foreground="{StaticResource NotificationTextBrush}"
                           FontSize="13"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           LineHeight="18"/>
            </StackPanel>

            <!-- 右侧关闭按钮 -->
            <Button Grid.Column="2"
                    x:Name="CloseButton"
                    Width="24" Height="24"
                    Background="Transparent"
                    BorderThickness="0"
                    VerticalAlignment="Top"
                    Margin="6,0,0,0"
                    Click="CloseButton_Click"
                    Cursor="Hand"
                    ToolTip="关闭通知">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBorder" Background="Transparent" CornerRadius="4">
                            <TextBlock x:Name="CloseIcon"
                                       Text="✕"
                                       FontSize="12"
                                       Foreground="{StaticResource NotificationCloseBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" TargetName="CloseIcon" Value="#E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</UserControl>