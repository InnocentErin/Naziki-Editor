<Window x:Class="Naziki_Editor.Views.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Naziki_Editor.Views.Settings"
        xmlns:settings="clr-namespace:Naziki_Editor.Core.Settings"
        xmlns:vm="clr-namespace:Naziki_Editor.ViewModels.Settings"
        Title="Naziki Editor - 设置"
        Height="580" Width="820"
        MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        Background="{DynamicResource MainBgColor}"
        Foreground="{DynamicResource MainTextColor}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">

    <!--
        🎛️ 设置器窗口控件
        左侧面板：设置分类导航（ListBox）
        右侧面板：当前分类的设置内容（动态加载）
        整体采用 MVVM 模式，通过 SettingsWindowViewModel 驱动
    -->

    <Window.Resources>
        <!-- ========================================== -->
        <!-- 🎯 设置项值类型 → 控件模板选择器 -->
        <!-- ========================================== -->
        <DataTemplate x:Key="BoolSettingTemplate" DataType="{x:Type settings:SettingItem}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource MainTextColor}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"
                               MaxWidth="400"/>
                </StackPanel>
                <CheckBox Grid.Column="1" IsChecked="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          IsEnabled="{Binding IsEnabled}">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Grid Background="Transparent" Cursor="Hand">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ToggleBorder" Grid.Column="0"
                                        Width="40" Height="22" CornerRadius="11"
                                        Background="{DynamicResource TipsColor}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <Ellipse x:Name="ToggleThumb" Width="16" Height="16"
                                             Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="开启" VerticalAlignment="Center"
                                           Margin="8,0,0,0" FontSize="11"
                                           Foreground="{DynamicResource SecTextColor}"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="Background"
                                            Value="{DynamicResource HighlightBorderColor}"/>
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush"
                                            Value="{DynamicResource HighlightBorderColor}"/>
                                    <Setter TargetName="ToggleThumb" Property="Margin" Value="20,0,0,0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder" Property="BorderBrush"
                                            Value="{DynamicResource HighlightBorderColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StringSettingTemplate" DataType="{x:Type settings:SettingItem}">
            <Grid Margin="0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource MainTextColor}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0" Padding="8,4"
                         Background="{DynamicResource BoardBgColor}"
                         Foreground="{DynamicResource MainTextColor}"
                         BorderBrush="{DynamicResource BorderColor}"
                         BorderThickness="1"
                         IsEnabled="{Binding IsEnabled}"
                         MaxWidth="400"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IntegerSettingTemplate" DataType="{x:Type settings:SettingItem}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource MainTextColor}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"
                               MaxWidth="380"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                         Width="80" Padding="8,4" VerticalAlignment="Center"
                         Background="{DynamicResource BoardBgColor}"
                         Foreground="{DynamicResource MainTextColor}"
                         BorderBrush="{DynamicResource BorderColor}"
                         BorderThickness="1"
                         IsEnabled="{Binding IsEnabled}"
                         TextAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FloatSettingTemplate" DataType="{x:Type settings:SettingItem}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource MainTextColor}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"
                               MaxWidth="380"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:F2}}"
                         Width="80" Padding="8,4" VerticalAlignment="Center"
                         Background="{DynamicResource BoardBgColor}"
                         Foreground="{DynamicResource MainTextColor}"
                         BorderBrush="{DynamicResource BorderColor}"
                         BorderThickness="1"
                         IsEnabled="{Binding IsEnabled}"
                         TextAlignment="Center"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ComboSettingTemplate" DataType="{x:Type settings:SettingItem}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource MainTextColor}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"
                               MaxWidth="380"/>
                </StackPanel>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding ComboOptions}"
                          SelectedItem="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                          Width="150" VerticalAlignment="Center"
                          IsEnabled="{Binding IsEnabled}"
                          Background="{DynamicResource BoardBgColor}"
                          Foreground="{DynamicResource MainTextColor}"
                          BorderBrush="{DynamicResource BorderColor}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ColorSettingTemplate" DataType="{x:Type settings:SettingItem}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource MainTextColor}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"
                               MaxWidth="380"/>
                </StackPanel>
                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="4"
                            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                            Margin="0,0,8,0"
                            Background="{Binding CurrentValue, Converter={x:Static local:SettingsWindow.ColorStringToBrushConverter}}"/>
                    <TextBox Grid.Column="1" Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                             Width="80" Padding="4,2"
                             Background="{DynamicResource BoardBgColor}"
                             Foreground="{DynamicResource MainTextColor}"
                             BorderBrush="{DynamicResource BorderColor}"
                             BorderThickness="1"
                             IsEnabled="{Binding IsEnabled}"/>
                </Grid>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MultiLineSettingTemplate" DataType="{x:Type settings:SettingItem}">
            <Grid Margin="0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource MainTextColor}"/>
                    <TextBlock Text="{Binding Description}" FontSize="11"
                               Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBox Grid.Row="1" Text="{Binding CurrentValue, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,6,0,0" Padding="8,4"
                         Height="80" AcceptsReturn="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource BoardBgColor}"
                         Foreground="{DynamicResource MainTextColor}"
                         BorderBrush="{DynamicResource BorderColor}"
                         BorderThickness="1"
                         IsEnabled="{Binding IsEnabled}"
                         MaxWidth="400"/>
            </Grid>
        </DataTemplate>

        <!-- ========================================== -->
        <!-- ⌨️ 快捷键绑定模板 -->
        <!-- ========================================== -->
        <DataTemplate x:Key="KeyBindingTemplate" DataType="{x:Type settings:SettingItem}">
            <Border Margin="0,4" Padding="12,10"
                    Background="{DynamicResource BoardBgColor}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 标题行：名称 + 当前快捷键 -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource MainTextColor}"/>
                            <TextBlock Text="{Binding Description}" FontSize="11"
                                       Foreground="{DynamicResource SecTextColor}" TextWrapping="Wrap"
                                       MaxWidth="350"/>
                        </StackPanel>

                        <!-- 当前快捷键显示 / 录制按钮 -->
                        <Border x:Name="KeyGestureBorder" Grid.Column="1"
                                MinWidth="100" Height="32" CornerRadius="4"
                                Background="{DynamicResource MainBgColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                Cursor="Hand" Margin="10,0,0,0"
                                MouseLeftButtonDown="KeyBindingBorder_MouseLeftButtonDown"
                                Tag="{Binding}">
                            <Border.Resources>
                                <local:KeyBindingRecordingConverter x:Key="RecordingConverter"/>
                                <local:InverseBooleanConverter x:Key="InverseBoolConverter"/>
                            </Border.Resources>
                            <Grid>
                                <TextBlock x:Name="KeyGestureText"
                                           Text="{Binding CurrentValue}"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource HighlightBorderColor}"
                                           Visibility="{Binding IsRecording, Converter={StaticResource InverseBoolConverter}}"/>
                                <TextBlock x:Name="RecordingHint"
                                           Text="🎤 按下快捷键..."
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{DynamicResource TipsColor}"
                                           Visibility="{Binding IsRecording, Converter={StaticResource RecordingConverter}}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 冲突警告 -->
                    <Border Grid.Row="1" Margin="0,6,0,0" Padding="8,6"
                            Background="{DynamicResource NotificationWarningBgBrush}" CornerRadius="3"
                            Visibility="{Binding ConflictBindings.Count, Converter={x:Static local:SettingsWindow.CountToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="⚠️ 快捷键冲突：" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource NotificationErrorBrush}"/>
                            <ItemsControl ItemsSource="{Binding ConflictBindings}" Margin="6,2,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="10"
                                                   Foreground="{DynamicResource NotificationWarningBrush}" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- 操作按钮行 -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="BtnRecord" Content="🎤 录制新快捷键"
                                Width="130" Padding="6,4" FontSize="11"
                                Background="{DynamicResource SideBgColor}"
                                Foreground="{DynamicResource SecTextColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                Click="KeyBindingRecord_Click"
                                Tag="{Binding}"/>
                        <Button x:Name="BtnClear" Content="✕ 清除"
                                Width="70" Padding="6,4" FontSize="11" Margin="6,0,0,0"
                                Background="{DynamicResource SideBgColor}"
                                Foreground="{DynamicResource SecTextColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                Click="KeyBindingClear_Click"
                                Tag="{Binding}"
                                ToolTip="清除快捷键绑定（设置为空）"/>
                        <Button x:Name="BtnReset" Content="↺ 默认"
                                Width="70" Padding="6,4" FontSize="11" Margin="6,0,0,0"
                                Background="{DynamicResource SideBgColor}"
                                Foreground="{DynamicResource SecTextColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                Click="KeyBindingReset_Click"
                                Tag="{Binding}"
                                ToolTip="恢复为默认快捷键"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ========================================== -->
        <!-- 🎯 值类型 → 模板选择器 -->
        <!-- ========================================== -->
        <local:SettingItemTemplateSelector x:Key="SettingItemTemplateSelector"
            BoolTemplate="{StaticResource BoolSettingTemplate}"
            StringTemplate="{StaticResource StringSettingTemplate}"
            IntegerTemplate="{StaticResource IntegerSettingTemplate}"
            FloatTemplate="{StaticResource FloatSettingTemplate}"
            ComboTemplate="{StaticResource ComboSettingTemplate}"
            ColorTemplate="{StaticResource ColorSettingTemplate}"
            MultiLineTemplate="{StaticResource MultiLineSettingTemplate}"
            KeyBindingTemplate="{StaticResource KeyBindingTemplate}"/>

        <!-- ========================================== -->
        <!-- 🎯 左侧导航栏 ListBoxItem 样式 -->
        <!-- ========================================== -->
        <Style x:Key="CategoryNavItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecTextColor}"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="NavBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="3,0,0,0"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                           VerticalAlignment="Center" FontSize="13"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ItemCount, StringFormat='({0})'}"
                                           VerticalAlignment="Center" FontSize="11"
                                           Foreground="{DynamicResource TipsColor}"
                                           Margin="6,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavBorder" Property="Background"
                                        Value="{DynamicResource BoardBgColor}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="NavBorder" Property="Background"
                                        Value="{DynamicResource BoardBgColor}"/>
                                <Setter TargetName="NavBorder" Property="BorderBrush"
                                        Value="{DynamicResource HighlightBorderColor}"/>
                                <Setter Property="Foreground" Value="{DynamicResource HighlightBorderColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ========================================== -->
    <!-- 🏗️ 主布局：左右分栏 -->
    <!-- ========================================== -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="180"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*" MinWidth="400"/>
        </Grid.ColumnDefinitions>

        <!-- 📋 左侧导航面板 -->
        <Border Grid.Column="0" Background="{DynamicResource SideBgColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 导航标题 -->
                <Border Grid.Row="0" Padding="14,14" Background="{DynamicResource SideBgColor}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <TextBlock Text="📋 设置分类" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource MainTextColor}"/>
                </Border>

                <!-- 分类列表 -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource CategoryNavItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,4,0,0"/>
            </Grid>
        </Border>

        <!-- 分隔线 -->
        <Border Grid.Column="1" Background="{DynamicResource BorderColor}"/>

        <!-- 📝 右侧内容面板 -->
        <Border Grid.Column="2" Background="{DynamicResource MainBgColor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 顶部工具栏：搜索 + 操作按钮 -->
                <Border Grid.Row="0" Padding="16,12"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- 搜索框 -->
                        <Border Grid.Column="0" Background="{DynamicResource BoardBgColor}"
                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                CornerRadius="4" Padding="6,0" MaxWidth="300">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center"
                                           Margin="0,0,6,0" Foreground="{DynamicResource TipsColor}"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource MainTextColor}"
                                         VerticalAlignment="Center" Padding="0,4"
                                         Style="{x:Null}"/>
                            </Grid>
                        </Border>

                        <!-- 操作按钮 -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="↺ 重置分类" Command="{Binding ResetCategoryCommand}"
                                    Margin="0,0,8,0" Padding="10,5" FontSize="12"
                                    Background="{DynamicResource SideBgColor}"
                                    Foreground="{DynamicResource SecTextColor}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    ToolTip="将当前分类的所有设置恢复为默认值"/>
                            <Button Content="↻ 全部重置" Command="{Binding ResetAllCommand}"
                                    Padding="10,5" FontSize="12"
                                    Background="{DynamicResource SideBgColor}"
                                    Foreground="{DynamicResource SecTextColor}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    ToolTip="将所有设置恢复为默认值"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 设置项列表 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
                    <ItemsControl ItemsSource="{Binding CurrentItems}"
                                  ItemTemplateSelector="{StaticResource SettingItemTemplateSelector}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- 底部操作栏 -->
                <Border Grid.Row="2" Padding="16,12"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource SideBgColor}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="取消" Command="{Binding CancelCommand}"
                                Width="90" Padding="10,6" Margin="0,0,10,0"
                                Background="{DynamicResource BoardBgColor}"
                                Foreground="{DynamicResource MainTextColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                ToolTip="放弃所有更改并关闭"/>
                        <Button Content="💾 保存设置" Command="{Binding SaveCommand}"
                                Width="110" Padding="10,6"
                                Background="{DynamicResource HighlightBorderColor}"
                                Foreground="White" FontWeight="Bold"
                                BorderThickness="0"
                                ToolTip="保存当前设置并关闭"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>