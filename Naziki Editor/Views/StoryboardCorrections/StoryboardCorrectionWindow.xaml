<Window x:Class="Naziki_Editor.Views.StoryboardCorrections.StoryboardCorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="故事板检查与修正" Width="1050" Height="720"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MainBgColor}"
        Foreground="{DynamicResource MainTextColor}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Padding="12" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="故事板检查与修正" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtPath" Margin="0,5,0,0" Foreground="{DynamicResource SecTextColor}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtSummary" Margin="0,4,0,0"/>
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="BtnFixMissing" Content="一键修正缺失初始时间"
                            Padding="12,7" Margin="0,0,8,0" Click="BtnFixMissing_Click"/>
                    <Button x:Name="BtnSafeMerge" Content="一键安全合并"
                            Padding="12,7" Margin="0,0,8,0" Click="BtnSafeMerge_Click"/>
                    <TextBlock Text="错位：" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtBatchOffset" Text="+0.2" Width="62" Padding="5"
                             VerticalContentAlignment="Center"/>
                    <TextBlock Text="s" VerticalAlignment="Center" Margin="3,0,6,0"/>
                    <Button x:Name="BtnOffsetAll" Content="一键错位冲突"
                            Padding="12,7" Margin="0,0,8,0" Click="BtnOffsetAll_Click"/>
                    <Button Content="搜索 / 重新搜索" Padding="14,7" Click="BtnSearch_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,8">
            <TextBlock Text="筛选：" VerticalAlignment="Center"/>
            <ComboBox x:Name="CmbFilter" Width="180" SelectionChanged="CmbFilter_SelectionChanged">
                <ComboBoxItem Content="全部问题" Tag="All" IsSelected="True"/>
                <ComboBoxItem Content="缺失初始时间" Tag="MissingBaseTime"/>
                <ComboBoxItem Content="同时间冲突" Tag="SameTimeConflict"/>
                <ComboBoxItem Content="无法解析时间" Tag="UnresolvedTime"/>
            </ComboBox>
            <TextBlock Text=" 搜索：" Margin="16,0,4,0" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtSearch" Width="260" Padding="5"
                     TextChanged="TxtSearch_TextChanged"/>
        </StackPanel>

        <ListBox Grid.Row="2" x:Name="IssueList"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"/>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="搜索不会修改数据；确认修正后才会生成一个可撤销步骤。"
                       Foreground="{DynamicResource SecTextColor}" VerticalAlignment="Center"/>
            <Button Content="关闭" Padding="18,7" HorizontalAlignment="Right"
                    DockPanel.Dock="Right" Click="BtnClose_Click"/>
        </DockPanel>
    </Grid>
</Window>
