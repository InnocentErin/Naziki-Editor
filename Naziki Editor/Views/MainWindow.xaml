<Window x:Class="Naziki_Editor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Naziki_Editor.Views"
        xmlns:notifications="clr-namespace:Naziki_Editor.Views.Notifications"
        Title="Naziki Editor" 
        Height="720" Width="1280"
        MinWidth="800" MinHeight="600"
        WindowStyle="None" x:Name="MainWindowInstance"
        Background="{DynamicResource MainBgColor}" 
        BorderBrush="{DynamicResource BorderColor}"
        Foreground="{DynamicResource MainTextColor}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextColor}"/>
            <Setter Property="Width" Value="45"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextColor}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Separator">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WelcomeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource MainTextColor}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="16,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3A5C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="65*" MinHeight="200"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="35*" MinHeight="200"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource MainBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False">
                    <TextBlock Text="🛸" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Title, ElementName=MainWindowInstance}" Foreground="{DynamicResource SecTextColor}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="BtnMinimize_Click" ToolTip="最小化">
                        <Path Data="M 0,5 L 10,5" Stroke="{DynamicResource MainTextColor}" StrokeThickness="1" Width="10" Height="10"/>
                    </Button>
                    <Button Style="{StaticResource TitleBarButtonStyle}" Click="BtnMaximize_Click" ToolTip="最大化/还原">
                        <Path Data="M 1,1 L 9,1 L 9,9 L 1,9 Z" Stroke="{DynamicResource MainTextColor}" StrokeThickness="1" Fill="Transparent" Width="10" Height="10"/>
                    </Button>
                    <Button Content="✕" FontSize="14" Style="{StaticResource TitleBarCloseButtonStyle}" Click="BtnClose_Click" ToolTip="关闭程序"/>
                </StackPanel>
            </Grid>
        </Border>

        <Menu Grid.Row="1" Background="{DynamicResource MainBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1" >
            <MenuItem Header="文件(_F)" >
                <MenuItem Header="📂 打开工程 (Open Project...)" Click="MenuOpenProject_Click"/>
                <MenuItem Header="💾 保存工程 (Save Project)" Click="MenuSave_Click"/>
                <Separator/>
                <MenuItem Header="🎵 导入 Cytoid 谱面 (Import Chart...)" Click="MenuImportChart_Click"/>
                <MenuItem Header="🎬 导入 故事板 (Import Storyboard...)" Click="MenuImportStoryboard_Click"/>
                <MenuItem Header="导入音频 (Import Audio)..." Click="MenuImportAudio_Click"/>
                <Separator/>
                <MenuItem Header="保存(_S)" Name="MenuSave" Click="MenuSave_Click" InputGestureText="Ctrl+S"/>
                <Separator Background="{DynamicResource SeparatorColor}"/>
                <MenuItem Header="退出(_X)" Name="MenuExit" Click="MenuExit_Click" InputGestureText="Alt+F4"/>
            </MenuItem>

            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤回时光(_U)" Name="MenuUndo" Click="MenuUndo_Click" InputGestureText="Ctrl+Z"/>
                <MenuItem Header="快进时光(_R)" Name="MenuRedo" Click="MenuRedo_Click" InputGestureText="Ctrl+Y"/>
            </MenuItem>

            <MenuItem Header="工具(_T)">
                <MenuItem Header="🧰 故事板检查与修正..." Name="MenuStoryboardCorrection"
                          Click="MenuStoryboardCorrection_Click"/>
                <Separator/>
                <MenuItem Header="⚙️ 设置(_S)..." Name="MenuSettings" Click="MenuSettings_Click" InputGestureText="Ctrl+,"/>
            </MenuItem>

            <MenuItem Header="关于(_A)">
                <MenuItem Header="关于 Naziki Studio..." Name="MenuAbout" Click="MenuAbout_Click"/>
            </MenuItem>
        </Menu>

        <!-- 工具栏 -->
        <Border Grid.Row="2" Background="{DynamicResource MainBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                <Button Content="📄" ToolTip="新建项目" Width="28" Height="24" Click="ToolbarNew_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="📂" ToolTip="打开项目" Width="28" Height="24" Click="ToolbarOpen_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="💾" ToolTip="保存" Width="28" Height="24" Click="ToolbarSave_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Separator Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Content="↩" ToolTip="撤销" Width="28" Height="24" Click="ToolbarUndo_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="↪" ToolTip="重做" Width="28" Height="24" Click="ToolbarRedo_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Separator Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Content="▶" ToolTip="播放" Width="28" Height="24" Click="ToolbarPlay_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="⏸" ToolTip="暂停" Width="28" Height="24" Click="ToolbarPause_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="⏹" ToolTip="停止" Width="28" Height="24" Click="ToolbarStop_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Separator Style="{StaticResource ToolbarSeparatorStyle}"/>
                <Button Content="−" ToolTip="缩小" Width="22" Height="24" Click="ToolbarZoomOut_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Slider x:Name="ZoomSlider" Width="100" Height="24" Minimum="10" Maximum="200" Value="100"
                        TickFrequency="10" IsSnapToTickEnabled="True"
                        VerticalAlignment="Center" Margin="2,0"
                        ValueChanged="ZoomSlider_ValueChanged"/>
                <Button Content="+" ToolTip="放大" Width="22" Height="24" Click="ToolbarZoomIn_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="↺" ToolTip="重置缩放" Width="22" Height="24" Click="ToolbarZoomReset_Click" Style="{StaticResource ToolbarButtonStyle}"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="15*" MinWidth="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18*" MinWidth="250"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="52*" MinWidth="400"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="15*" MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <local:EventListControl x:Name="EventList" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}" Cursor="SizeWE"/>
            <local:NoteListControl x:Name="NoteList" Grid.Column="2" />
            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}" Cursor="SizeWE"/>
            <local:CanvasControl x:Name="CanvasArea" Grid.Column="4" />
            <GridSplitter Grid.Column="5" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}" Cursor="SizeWE"/>
            <local:PropertyPanelControl x:Name="PropertyPanel" Grid.Column="6" />
        </Grid>

        <!-- 欢迎页：无项目时覆盖在内容区域上方 -->
        <Grid x:Name="WelcomePage" Grid.Row="3" Background="{DynamicResource MainBgColor}" Visibility="Visible" Panel.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🛸 Naziki Editor" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource MainTextColor}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                <TextBlock Text="欢迎使用故事板编辑器" FontSize="14"
                           Foreground="{DynamicResource SecTextColor}" HorizontalAlignment="Center" Margin="0,0,0,30"/>

                <Button Content="📂 打开已有项目" Width="240" Height="40" Margin="0,0,0,12"
                        Click="WelcomeOpenProject_Click" Style="{StaticResource WelcomeButtonStyle}"/>
                <Button Content="✨ 创建新故事板" Width="240" Height="40" Margin="0,0,0,12"
                        Click="WelcomeNewStoryboard_Click" Style="{StaticResource WelcomeButtonStyle}"/>
                <Button Content="📋 从模板创建" Width="240" Height="40" Margin="0,0,0,12"
                        Click="WelcomeFromTemplate_Click" Style="{StaticResource WelcomeButtonStyle}"/>

                <TextBlock Text="最近项目" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource SecTextColor}" Margin="0,20,0,8"/>
                <ListBox x:Name="RecentProjectsList" Width="240" Height="120"
                         Background="{DynamicResource BorderColor}" BorderThickness="0"
                         Foreground="{DynamicResource MainTextColor}"
                         MouseDoubleClick="RecentProjectsList_MouseDoubleClick"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{DynamicResource BorderColor}" Cursor="SizeNS"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="35*" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="65*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <local:AssetListControl x:Name="AssetList" Grid.Column="0" />
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource BorderColor}" Cursor="SizeWE"/>
            <local:TimelineControl x:Name="TimelineConsole" Grid.Column="2" />
        </Grid>

        <!-- 状态栏 -->
        <StatusBar Grid.Row="6" Background="{DynamicResource MainBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
                   VerticalAlignment="Stretch" Padding="0">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem Grid.Column="0" Margin="8,0">
                <TextBlock x:Name="StatusPlaybackTime" Text="00:00 / 00:00" FontSize="11"
                           Foreground="{DynamicResource SecTextColor}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="1" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusSelectedObject" Text="" FontSize="11"
                           Foreground="{DynamicResource SecTextColor}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="2" Margin="0,0,8,0">
                <TextBlock x:Name="StatusObjectCount" Text="对象: 0" FontSize="11"
                           Foreground="{DynamicResource SecTextColor}"/>
            </StatusBarItem>
            <StatusBarItem Grid.Column="3" Margin="0,0,8,0">
                <TextBlock x:Name="StatusModified" Text="" FontSize="11"
                           Foreground="Orange"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
