<UserControl x:Class="Naziki_Editor.Views.EventListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="250"
             Background="{DynamicResource MainBgColor}" 
             BorderBrush="{DynamicResource BorderColor}"
             Foreground="{DynamicResource MainTextColor}">

    <Border Background="{DynamicResource MainBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="55"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TabControl x:Name="EventTabControl" Grid.ColumnSpan="2" TabStripPlacement="Left" 
                            Background="Transparent" BorderThickness="0"
                            ItemContainerStyle="{DynamicResource VerticalTabItemStyle}"
                            SelectionChanged="EventTabControl_SelectionChanged">

                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="55"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="{DynamicResource SideBgColor}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,0,1,0">
                                    <TabPanel IsItemsHost="True" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>

                                <Grid Grid.Column="1" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <UniformGrid Grid.Row="0" Columns="3" Margin="5,5,5,2">
                                        <Button Content="➕ 图片" x:Name="BtnAddSprite" Click="BtnAddSprite_Click" Margin="2" Padding="0,5" Background="{DynamicResource MenuBgColor}" Foreground="{DynamicResource MainTextColor}" BorderBrush="{DynamicResource BorderColor}" Cursor="Hand"/>
                                        <Button Content="➕ 文字" x:Name="BtnAddText" Click="BtnAddText_Click" Margin="2" Padding="0,5" Background="{DynamicResource MenuBgColor}" Foreground="{DynamicResource MainTextColor}" BorderBrush="{DynamicResource BorderColor}" Cursor="Hand"/>
                                        <Button Content="➕ 线条" x:Name="BtnAddLine" Click="BtnAddLine_Click" Margin="2" Padding="0,5" Background="{DynamicResource MenuBgColor}" Foreground="{DynamicResource MainTextColor}" BorderBrush="{DynamicResource BorderColor}" Cursor="Hand"/>
                                        <Button Content="➕ 视频" x:Name="BtnAddVideo" Click="BtnAddVideo_Click" Margin="2" Padding="0,5" Background="{DynamicResource MenuBgColor}" Foreground="{DynamicResource MainTextColor}" BorderBrush="{DynamicResource BorderColor}" Cursor="Hand"/>
                                        <Button Content="➕ 场景" x:Name="BtnAddScene" Click="BtnAddScene_Click" Margin="2" Padding="0,5" Background="{DynamicResource MenuBgColor}" Foreground="{DynamicResource MainTextColor}" BorderBrush="{DynamicResource BorderColor}" Cursor="Hand"/>
                                        <Button Content="➕ 音符" x:Name="BtnAddNoteCtrl" Click="BtnAddNoteCtrl_Click" Margin="2" Padding="0,5" Background="{DynamicResource MenuBgColor}" Foreground="{DynamicResource MainTextColor}" BorderBrush="{DynamicResource BorderColor}" Cursor="Hand"/>
                                    </UniformGrid>

                                    <TextBox x:Name="TxtSearchFilter" Grid.Row="1" Margin="5,2,5,5" Padding="5,3"
                                             FontSize="12" Background="{DynamicResource MenuBgColor}" 
                                             Foreground="{DynamicResource MainTextColor}"
                                             BorderBrush="{DynamicResource BorderColor}"
                                             TextChanged="TxtSearchFilter_TextChanged"
                                             Tag="🔍 搜索事件..."/>

                                    <Border Grid.Row="2" Background="Transparent">
                                        <ContentPresenter ContentSource="SelectedContent"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabItem Header="图片">
                        <ListBox x:Name="SpriteListBox" MouseDoubleClick="EventTree_MouseDoubleClick" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding WarningBrush}" ToolTip="{Binding WarningToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" 
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="{DynamicResource MainTextColor}" 
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource SecTextColor}" 
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="文字">
                        <ListBox x:Name="TextListBox" MouseDoubleClick="EventTree_MouseDoubleClick" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding WarningBrush}" ToolTip="{Binding WarningToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" 
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="{DynamicResource MainTextColor}" 
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource SecTextColor}" 
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="线条">
                        <ListBox x:Name="LinesListBox" MouseDoubleClick="EventTree_MouseDoubleClick" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding WarningBrush}" ToolTip="{Binding WarningToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" 
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="{DynamicResource MainTextColor}" 
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource SecTextColor}" 
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="视频">
                        <ListBox x:Name="VideoListBox" MouseDoubleClick="EventTree_MouseDoubleClick" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding WarningBrush}" ToolTip="{Binding WarningToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" 
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="{DynamicResource MainTextColor}" 
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource SecTextColor}" 
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="场景">
                        <ListBox x:Name="SceneListBox" MouseDoubleClick="EventTree_MouseDoubleClick" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding WarningBrush}" ToolTip="{Binding WarningToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" 
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="{DynamicResource MainTextColor}" 
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource SecTextColor}" 
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="音符">
                        <ListBox x:Name="NoteCtrlListBox" MouseDoubleClick="EventTree_MouseDoubleClick" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding WarningBrush}" ToolTip="{Binding WarningToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" 
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="{DynamicResource MainTextColor}" 
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource SecTextColor}" 
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                    <TabItem Header="模板">
                        <ListBox x:Name="EventTemplateListBox" MouseDoubleClick="EventTree_MouseDoubleClick" SelectionMode="Extended" SelectionChanged="ListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Background="{Binding WarningBrush}" ToolTip="{Binding WarningToolTip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="{DynamicResource AccentColor}" 
                                                   FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DisplayContent}" Foreground="{DynamicResource MainTextColor}" 
                                                   FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,0"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DisplayTime}" Foreground="{DynamicResource SecTextColor}" 
                                                   FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,0"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </TabItem>
                </TabControl>

                <StackPanel x:Name="DynamicEmptyHint" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="这里空空如也" Background="{DynamicResource MainBgColor}" HorizontalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                        <TextBlock Text="快来添加“" Background="{DynamicResource MainBgColor}" FontSize="10"/>
                        <TextBlock Text="{Binding SelectedItem.Header, ElementName=EventTabControl}" Background="{DynamicResource MainBgColor}" FontSize="10"/>
                        <TextBlock Text="”事件吧！" Background="{DynamicResource MainBgColor}" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Button Grid.Row="1" x:Name="BtnDeleteEvent" Content="🗑️ 删除选中的事件" Click="BtnDeleteEvent_Click" 
                    Margin="10,5,10,10" Padding="5,8" Background="{DynamicResource VirtualLineBrush}" Foreground="White" 
                    FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>

            <Border x:Name="ChartMissingOverlay" Grid.RowSpan="2" Background="#F9E2AF" Panel.ZIndex="998" Visibility="Visible" 
                    Height="32" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ 当前未导入谱面，Note Controller 相关功能将受限" 
                               Foreground="#1E1E2E" FontSize="11" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnOverlayImportChart" Content="🎵 导入谱面" Padding="8,2" 
                            Background="#1E1E2E" Foreground="#F9E2AF" BorderThickness="0" Cursor="Hand" 
                            Click="BtnOverlayImportChart_Click" FontSize="11"/>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>
