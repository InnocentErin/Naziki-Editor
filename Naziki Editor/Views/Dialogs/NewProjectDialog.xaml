<Window x:Class="Naziki_Editor.Views.Dialogs.NewProjectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="✨ 新建故事板项目"
        Width="480" Height="360"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#1E1E2E" CornerRadius="12" BorderBrush="#45475A" BorderThickness="1">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="✨ 新建故事板项目" FontSize="20" FontWeight="Bold" Foreground="#CDD6F4"/>
                <Button Content="✕" HorizontalAlignment="Right" Width="30" Height="30"
                        Background="Transparent" Foreground="#A6ADC8" BorderThickness="0"
                        Click="BtnClose_Click" FontSize="14"/>
            </Grid>

            <!-- 项目名称 -->
            <TextBlock Grid.Row="1" Text="项目名称" FontSize="13" Foreground="#A6ADC8" Margin="0,0,0,6"/>
            <TextBox Grid.Row="2" x:Name="TxtProjectName" Text="未命名故事板" FontSize="14"
                     Foreground="#CDD6F4" Background="#313244" BorderBrush="#45475A"
                     BorderThickness="1" Padding="10,8" Margin="0,0,0,16"
                     CaretBrush="#CDD6F4"/>

            <!-- 模板选择 -->
            <TextBlock Grid.Row="3" Text="模板" FontSize="13" Foreground="#A6ADC8" Margin="0,0,0,6"/>
            <ComboBox Grid.Row="4" x:Name="CmbTemplate" FontSize="13"
                      Foreground="#CDD6F4" Background="#313244" BorderBrush="#45475A"
                      BorderThickness="1" Padding="8,6" Margin="0,0,0,16">
                <ComboBoxItem Content="📄 空白模板" Tag="blank" IsSelected="True"/>
                <ComboBoxItem Content="🎬 基础模板（含场景控制器）" Tag="basic"/>
            </ComboBox>

            <!-- 选项 -->
            <StackPanel Grid.Row="5" Margin="0,4,0,0">
                <CheckBox x:Name="ChkImportChart" Content="📊 导入谱面文件 (.json)" FontSize="13"
                          Foreground="#CDD6F4" Margin="0,0,0,10"/>
                <CheckBox x:Name="ChkImportAudio" Content="🎵 导入音频文件" FontSize="13"
                          Foreground="#CDD6F4"/>
            </StackPanel>

            <!-- 按钮 -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Width="80" Height="34" Margin="0,0,10,0"
                        Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                        Click="BtnCancel_Click" FontSize="13"/>
                <Button Content="创建项目" Width="100" Height="34"
                        Background="#CBA6F7" Foreground="#1E1E2E" BorderThickness="0"
                        Click="BtnCreate_Click" FontSize="13" FontWeight="Bold"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>