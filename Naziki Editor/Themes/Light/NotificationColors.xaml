<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题通知颜色资源 -->
    <Color x:Key="NotificationSuccessColor">#4CAF50</Color>
    <SolidColorBrush x:Key="NotificationSuccessBrush" Color="#4CAF50"/>
    <SolidColorBrush x:Key="NotificationSuccessBgBrush" Color="#E8F5E9"/>
    <SolidColorBrush x:Key="NotificationSuccessBorderBrush" Color="#A5D6A7"/>

    <Color x:Key="NotificationWarningColor">#FF9800</Color>
    <SolidColorBrush x:Key="NotificationWarningBrush" Color="#FF9800"/>
    <SolidColorBrush x:Key="NotificationWarningBgBrush" Color="#FFF3E0"/>
    <SolidColorBrush x:Key="NotificationWarningBorderBrush" Color="#FFCC80"/>

    <Color x:Key="NotificationErrorColor">#F44336</Color>
    <SolidColorBrush x:Key="NotificationErrorBrush" Color="#F44336"/>
    <SolidColorBrush x:Key="NotificationErrorBgBrush" Color="#FFEBEE"/>
    <SolidColorBrush x:Key="NotificationErrorBorderBrush" Color="#EF9A9A"/>

    <Color x:Key="NotificationInfoColor">#2196F3</Color>
    <SolidColorBrush x:Key="NotificationInfoBrush" Color="#2196F3"/>
    <SolidColorBrush x:Key="NotificationInfoBgBrush" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="NotificationInfoBorderBrush" Color="#90CAF9"/>

    <SolidColorBrush x:Key="NotificationTextBrush" Color="#212121"/>
    <SolidColorBrush x:Key="NotificationCloseBrush" Color="#757575"/>
    <SolidColorBrush x:Key="NotificationCloseHoverBrush" Color="#424242"/>
    <SolidColorBrush x:Key="NotificationShadowBrush" Color="#40000000"/>

</ResourceDictionary>