<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 浅色主题时间轴颜色资源 -->
    <SolidColorBrush x:Key="TimelineKeyframeFill" Color="#1F75FE"/>
    <SolidColorBrush x:Key="TimelineKeyframeStroke" Color="#333333"/>
    <SolidColorBrush x:Key="TimelineKeyframeHover" Color="#FFB300"/>
    <SolidColorBrush x:Key="TimelineKeyframeDragging" Color="#D32F2F"/>
    <SolidColorBrush x:Key="TimelineOpacityFill" Color="#F39C12"/>
    <SolidColorBrush x:Key="TimelineOpacityStroke" Color="#333333"/>
    <SolidColorBrush x:Key="TimelineOpacityHover" Color="#FFB300"/>
    <SolidColorBrush x:Key="TimelineOpacityDragging" Color="#D32F2F"/>
    <SolidColorBrush x:Key="TimelineActiveKeyframeFill" Color="#D32F2F"/>
    <SolidColorBrush x:Key="TimelineActiveKeyframeStroke" Color="#333333"/>
    <SolidColorBrush x:Key="TimelineTickColor" Color="#666666"/>

</ResourceDictionary>