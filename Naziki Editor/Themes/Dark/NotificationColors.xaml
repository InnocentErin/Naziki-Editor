<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 暗色主题通知颜色资源 -->
    <Color x:Key="NotificationSuccessColor">#81C784</Color>
    <SolidColorBrush x:Key="NotificationSuccessBrush" Color="#81C784"/>
    <SolidColorBrush x:Key="NotificationSuccessBgBrush" Color="#1B3D1B"/>
    <SolidColorBrush x:Key="NotificationSuccessBorderBrush" Color="#2E7D32"/>

    <Color x:Key="NotificationWarningColor">#FFB74D</Color>
    <SolidColorBrush x:Key="NotificationWarningBrush" Color="#FFB74D"/>
    <SolidColorBrush x:Key="NotificationWarningBgBrush" Color="#3D2E1A"/>
    <SolidColorBrush x:Key="NotificationWarningBorderBrush" Color="#E65100"/>

    <Color x:Key="NotificationErrorColor">#EF5350</Color>
    <SolidColorBrush x:Key="NotificationErrorBrush" Color="#EF5350"/>
    <SolidColorBrush x:Key="NotificationErrorBgBrush" Color="#3D1A1A"/>
    <SolidColorBrush x:Key="NotificationErrorBorderBrush" Color="#C62828"/>

    <Color x:Key="NotificationInfoColor">#64B5F6</Color>
    <SolidColorBrush x:Key="NotificationInfoBrush" Color="#64B5F6"/>
    <SolidColorBrush x:Key="NotificationInfoBgBrush" Color="#1A2D3D"/>
    <SolidColorBrush x:Key="NotificationInfoBorderBrush" Color="#1565C0"/>

    <SolidColorBrush x:Key="NotificationTextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="NotificationCloseBrush" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="NotificationCloseHoverBrush" Color="#BDBDBD"/>
    <SolidColorBrush x:Key="NotificationShadowBrush" Color="#40000000"/>

</ResourceDictionary>